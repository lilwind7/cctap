#!/usr/bin/env bash
# cctap — Claude Code → macOS notification bridge.
# Contract: exits 0 on every path, never writes to stdout, returns within ~1s.

set +e
trap 'exit 0' ERR

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$PROJECT_ROOT/lib"

# shellcheck source=lib/transcript.sh
source "$LIB_DIR/transcript.sh"
# shellcheck source=lib/notify.sh
source "$LIB_DIR/notify.sh"
# shellcheck source=lib/focus_check.sh
source "$LIB_DIR/focus_check.sh"

log() {
    local cache_dir="${HOME}/.cache/cctap"
    mkdir -p "$cache_dir" 2>/dev/null
    printf '[%s] %s\n' "$(date +%FT%T)" "$*" >> "$cache_dir/cctap.log" 2>/dev/null || true
}

# Read the payload once into a global var, then expose accessors.
CCTAP_PAYLOAD=""

read_payload() {
    CCTAP_PAYLOAD="$(cat)"
}

payload_field() {
    # Echo .${field} from CCTAP_PAYLOAD, empty string on missing/error.
    local field="$1"
    [ -z "$CCTAP_PAYLOAD" ] && { printf ''; return 0; }
    printf '%s' "$CCTAP_PAYLOAD" | jq -r --arg f "$field" '.[$f] // "" | tostring' 2>/dev/null || printf ''
}

handle_stop() {
    read_payload
    local cwd transcript_path
    cwd="$(payload_field cwd)"
    transcript_path="$(payload_field transcript_path)"

    [ -z "$cwd" ] && { log "stop: missing cwd"; return 0; }

    if is_warp_focused_on "$cwd"; then
        log "stop: Warp already focused on $cwd, skipping"
        return 0
    fi

    local proj_name summary
    proj_name="$(basename "$cwd")"
    summary="$(extract_last_user_message "$transcript_path")"

    send_notification \
        "${proj_name} · 已完成" \
        "$summary" \
        "Claude 已结束本轮" \
        "cctap:${cwd}" \
        "$cwd"
}

handle_notification() {
    read_payload
    local cwd msg
    cwd="$(payload_field cwd)"
    msg="$(payload_field message)"

    [ -z "$cwd" ] && { log "notification: missing cwd"; return 0; }

    if is_warp_focused_on "$cwd"; then
        log "notification: Warp focused on $cwd, skipping"
        return 0
    fi

    local proj_name
    proj_name="$(basename "$cwd")"

    send_notification \
        "${proj_name} · 待确认" \
        "$msg" \
        "" \
        "cctap:${cwd}" \
        "$cwd"
}

handle_session_end() {
    read_payload
    local cwd transcript_path reason
    cwd="$(payload_field cwd)"
    transcript_path="$(payload_field transcript_path)"
    reason="$(payload_field reason)"

    [ -z "$cwd" ] && { log "session-end: missing cwd"; return 0; }

    case "$reason" in
        clear|logout)
            log "session-end: normal ($reason), skipping"
            return 0
            ;;
    esac

    if is_warp_focused_on "$cwd"; then
        log "session-end: Warp focused on $cwd, skipping"
        return 0
    fi

    local proj_name summary
    proj_name="$(basename "$cwd")"
    summary="$(extract_last_user_message "$transcript_path")"

    send_notification \
        "${proj_name} · 异常退出" \
        "$summary" \
        "原因: ${reason:-unknown}" \
        "cctap:${cwd}" \
        "$cwd"
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        stop) handle_stop ;;
        notification) handle_notification ;;
        session-end) handle_session_end ;;
        *) log "unknown subcommand: $cmd" ;;
    esac
    return 0
}

main "$@"
exit 0
