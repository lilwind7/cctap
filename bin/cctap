#!/usr/bin/env bash
# cctap — Claude Code → macOS notification bridge.
# Contract (hook handlers only): exits 0 on every path, never writes to stdout,
# returns within ~1s. User-invoked subcommands (test-notify, doctor) may write
# to stdout and may return non-zero — `doctor` propagates its exit code so
# scripts can `if cctap doctor; then ...`.

set +e
trap 'exit 0' ERR

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$PROJECT_ROOT/lib"

# shellcheck source=lib/transcript.sh
source "$LIB_DIR/transcript.sh"
# shellcheck source=lib/notify.sh
source "$LIB_DIR/notify.sh"
# shellcheck source=lib/focus_check.sh
source "$LIB_DIR/focus_check.sh"

log() {
    local cache_dir="${HOME}/.cache/cctap"
    mkdir -p "$cache_dir" 2>/dev/null
    printf '[%s] %s\n' "$(date +%FT%T)" "$*" >> "$cache_dir/cctap.log" 2>/dev/null || true
}

# Read the payload once into a global var, then expose accessors.
CCTAP_PAYLOAD=""

read_payload() {
    CCTAP_PAYLOAD="$(cat)"
}

payload_field() {
    # Echo .${field} from CCTAP_PAYLOAD, empty string on missing/error.
    local field="$1"
    [ -z "$CCTAP_PAYLOAD" ] && { printf ''; return 0; }
    printf '%s' "$CCTAP_PAYLOAD" | jq -r --arg f "$field" '.[$f] // "" | tostring' 2>/dev/null || printf ''
}

handle_stop() {
    read_payload
    local cwd transcript_path
    cwd="$(payload_field cwd)"
    transcript_path="$(payload_field transcript_path)"

    [ -z "$cwd" ] && { log "stop: missing cwd"; return 0; }

    if is_warp_focused_on "$cwd"; then
        log "stop: Warp already focused on $cwd, skipping"
        return 0
    fi

    local proj_name summary
    proj_name="$(basename "$cwd")"
    summary="$(extract_last_user_message "$transcript_path")"

    send_notification \
        "${proj_name} · 已完成" \
        "$summary" \
        "Claude 已结束本轮" \
        "cctap:${cwd}" \
        "$cwd"
}

handle_notification() {
    read_payload
    local cwd msg
    cwd="$(payload_field cwd)"
    msg="$(payload_field message)"

    [ -z "$cwd" ] && { log "notification: missing cwd"; return 0; }

    if is_warp_focused_on "$cwd"; then
        log "notification: Warp focused on $cwd, skipping"
        return 0
    fi

    local proj_name
    proj_name="$(basename "$cwd")"

    send_notification \
        "${proj_name} · 待确认" \
        "$msg" \
        "" \
        "cctap:${cwd}" \
        "$cwd"
}

handle_session_end() {
    read_payload
    local cwd transcript_path reason
    cwd="$(payload_field cwd)"
    transcript_path="$(payload_field transcript_path)"
    reason="$(payload_field reason)"

    [ -z "$cwd" ] && { log "session-end: missing cwd"; return 0; }

    case "$reason" in
        clear|logout)
            log "session-end: normal ($reason), skipping"
            return 0
            ;;
    esac

    if is_warp_focused_on "$cwd"; then
        log "session-end: Warp focused on $cwd, skipping"
        return 0
    fi

    local proj_name summary
    proj_name="$(basename "$cwd")"
    summary="$(extract_last_user_message "$transcript_path")"

    send_notification \
        "${proj_name} · 异常退出" \
        "$summary" \
        "原因: ${reason:-unknown}" \
        "cctap:${cwd}" \
        "$cwd"
}

handle_test_notify() {
    send_notification \
        "cctap · 测试" \
        "如果你看到这条横幅，cctap 工作正常" \
        "点击会把 Warp 切到前台（如果装了的话）" \
        "cctap:test" \
        "$HOME"
    return 0
}

handle_doctor() {
    local ok=1

    printf "cctap doctor\n"
    printf -- "------------\n"

    if command -v terminal-notifier >/dev/null 2>&1; then
        printf "[ok]  terminal-notifier: %s\n" "$(command -v terminal-notifier)"
    else
        printf "[!!]  terminal-notifier: missing (brew install terminal-notifier)\n"
        ok=0
    fi

    if command -v jq >/dev/null 2>&1; then
        printf "[ok]  jq: %s\n" "$(command -v jq)"
    else
        printf "[!!]  jq: missing (brew install jq)\n"
        ok=0
    fi

    if command -v osascript >/dev/null 2>&1; then
        printf "[ok]  osascript: %s\n" "$(command -v osascript)"
    else
        printf "[!!]  osascript: missing (this should never happen on macOS)\n"
        ok=0
    fi

    if osascript -e 'tell application "System Events" to exists process "Warp"' 2>/dev/null | grep -q true; then
        printf "[ok]  Warp is running\n"
    else
        printf "[--]  Warp not currently running (this is fine, just informational)\n"
    fi

    local log="$HOME/.cache/cctap/cctap.log"
    if [ -f "$log" ]; then
        printf "\nRecent log entries:\n"
        tail -n 10 "$log"
    fi

    [ "$ok" = "1" ]
}

SETTINGS_FILE="$HOME/.claude/settings.json"
BACKUP_DIR="$HOME/.claude/backups"

backup_settings() {
    [ -f "$SETTINGS_FILE" ] || return 0
    mkdir -p "$BACKUP_DIR"
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    cp "$SETTINGS_FILE" "$BACKUP_DIR/settings.$ts.json"
}

# Canonicalize a path: resolve symlinks and absolutize.
canonical_path() {
    local p="$1"
    # On macOS, perl is available out of the box and has abs_path.
    if command -v perl >/dev/null 2>&1; then
        perl -MCwd -e 'print Cwd::abs_path($ARGV[0])' "$p" 2>/dev/null && return 0
    fi
    # Fallback: cd-and-pwd technique (does not resolve symlinks but absolutizes).
    local dir base
    dir="$(cd "$(dirname "$p")" 2>/dev/null && pwd)" || { printf '%s' "$p"; return 0; }
    base="$(basename "$p")"
    printf '%s/%s' "$dir" "$base"
}

handle_install() {
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    backup_settings

    local cctap_bin
    cctap_bin="$(canonical_path "${BASH_SOURCE[0]}")"

    local merge_script
    merge_script="$PROJECT_ROOT/share/install/merge_hooks.sh"
    if [ ! -x "$merge_script" ]; then
        printf "cctap: merge script not found at %s\n" "$merge_script" >&2
        return 1
    fi

    if ! "$merge_script" "$SETTINGS_FILE" "$cctap_bin"; then
        printf "cctap: merge failed; original settings.json preserved in %s\n" \
            "$BACKUP_DIR" >&2
        return 1
    fi

    printf "cctap installed.\n\n"
    printf "Permissions reminder:\n"
    printf "  System Settings → Privacy & Security → Automation\n"
    printf "    Terminal/Warp must be allowed to control: Warp, System Events.\n\n"
    printf "Running self-check...\n\n"
    handle_doctor || true
}

handle_uninstall() {
    [ -f "$SETTINGS_FILE" ] || { printf "Nothing to uninstall (no settings.json).\n"; return 0; }
    backup_settings
    local tmp
    tmp="$(mktemp)"
    jq '
        if .hooks == null then . else
            .hooks |= with_entries(
                .value |= map(
                    .hooks |= map(select(.command | test("(^|/)cctap( |$)") | not))
                ) | .value |= map(select(.hooks | length > 0))
            ) |
            .hooks |= with_entries(select(.value | length > 0))
        end
    ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
    printf "cctap hooks removed. Run 'brew uninstall cctap' to remove the binary.\n"
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        stop) handle_stop ;;
        notification) handle_notification ;;
        session-end) handle_session_end ;;
        test-notify) handle_test_notify ;;
        doctor) handle_doctor; exit $? ;;
        install) handle_install; exit $? ;;
        uninstall) handle_uninstall; exit $? ;;
        *) log "unknown subcommand: $cmd" ;;
    esac
    return 0
}

main "$@"
exit 0
